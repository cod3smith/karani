# Copy to .env and fill in real values. Do NOT commit .env.
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# Or the dedicated docker-compose stack (`make infra-up`):
# DATABASE_URL=postgresql://karani:karani@localhost:5433/karani

# --- Slack bridge (two-way; see docs/adrs/0010) ---
# Bot token (xoxb-...): scopes chat:write, im:history. Used for pushes.
# SLACK_BOT_TOKEN=xoxb-your-token
# App-level token (xapp-..., connections:write). Listener only.
# SLACK_APP_TOKEN=xapp-your-token
# Channel or DM id karani pushes to and listens in.
# SLACK_CHANNEL=D0XXXXXXX

# --- Autopilot (continuous hunt; ADR 0012) ---
# AUTOPILOT_MIN_FIT=85            # fit floor for unattended drafting
# AUTOPILOT_MAX_DRAFTS=3          # per-run cap (0 disables autopilot)
# AUTOPILOT_MAX_DRAFTS_PER_DAY=5  # shared daily budget across hourly runs

# --- Notion mirror (job-hunt board; ADR 0011) ---
# Internal integration token from notion.so/my-integrations. Share the
# parent page with the integration, then: `notion init <parent_page_id>`.
# NOTION_TOKEN=ntn_your-token
# NOTION_DATABASE_ID=printed-by-notion-init

# --- Application artifacts (MinIO; ADR 0014) ---
# karani's own MinIO from docker-compose (:9010 — 9000 may be taken).
# Unset = artifacts stay on disk only.
# MINIO_ENDPOINT=localhost:9010
# MINIO_ACCESS_KEY=karani
# MINIO_SECRET_KEY=karani-local-secret
# MINIO_BUCKET=karani-applications
# MINIO_PRESIGN_DAYS=7
# KARANI_HUMANIZE=on              # AI-voice scrub pass per pack
# KARANI_TAILOR_RESUME=on         # full tailored resume per pack

# --- Memory layer (docs/memory.md) ---
KARANI_MEMORY=basic                             # off | basic | mem0
# mem0 mode needs `uv sync --extra memory` + `make infra-up-llm` + models:
#   docker exec karani-ollama ollama pull nomic-embed-text
#   docker exec karani-ollama ollama pull llama3.2:3b
# Vector index lives in MEM0_PG_URL (default: compose db) — the ledger
# stays wherever DATABASE_URL points; the index is derived + disposable.
# MEM0_PG_URL=postgresql://karani:karani@localhost:5433/karani
# MEM0_OLLAMA_URL=http://localhost:11434
# MEM0_LLM_MODEL=llama3.2:3b
# MEM0_EMBEDDER_MODEL=nomic-embed-text
# MEM0_EMBED_DIMS=768
# MEM0_COLLECTION=karani_memories
# MEM0_USER_ID=kelyn

# --- LLM qualification (default provider: OpenRouter) ---
QUAL_PROVIDER=openrouter                        # openrouter | anthropic | local
QUAL_MODEL=moonshotai/kimi-k2-thinking          # any OpenRouter model slug
QUAL_REASONING_EFFORT=high                      # low | medium | high
QUAL_MAX_TOKENS=16000                           # reasoning counts toward this cap
QUAL_TIMEOUT_SECONDS=180                        # thinking models are slow
RESUME_PATH=data/resume.md

# OpenRouter (default provider)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_APP_NAME=karani
OPENROUTER_APP_URL=https://github.com/cod3smith/karani

# Anthropic (optional — install with `uv sync --extra anthropic`)
# ANTHROPIC_API_KEY=sk-ant-...

# Local LLM (optional — QUAL_PROVIDER=local; any OpenAI-compatible server:
# Ollama, LM Studio, vLLM, llama.cpp). Zero token cost; good for bulk
# qualification. Keep a stronger hosted model for drafting.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen3:32b
# LOCAL_LLM_TIMEOUT_SECONDS=600
# LOCAL_LLM_MAX_TOKENS=8000

# Optional overrides — see ingestion/config.py for defaults.
# MIN_COMP_USD=180000
# TARGET_COMP_USD=220000
# STALE_JOB_DAYS=10
# HTTP_CONCURRENCY=6
