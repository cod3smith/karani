# Copy to .env and fill in real values. Do NOT commit .env.
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# Or the dedicated docker-compose stack (`make infra-up`):
# DATABASE_URL=postgresql://karani:karani@localhost:5433/karani

# --- Slack bridge (two-way; see docs/adrs/0010) ---
# Bot token (xoxb-...): scopes chat:write, im:history. Used for pushes.
# SLACK_BOT_TOKEN=xoxb-your-token
# App-level token (xapp-..., connections:write). Listener only.
# SLACK_APP_TOKEN=xapp-your-token
# Channel or DM id karani pushes to and listens in.
# SLACK_CHANNEL=D0XXXXXXX

# --- Memory layer (docs/memory.md) ---
KARANI_MEMORY=basic                             # off | basic | mem0
# mem0 mode needs `uv sync --extra memory` + pgvector + (by default) Ollama.
# MEM0_LLM_PROVIDER=ollama
# MEM0_LLM_MODEL=qwen3:32b
# MEM0_EMBEDDER_PROVIDER=ollama
# MEM0_EMBEDDER_MODEL=nomic-embed-text
# MEM0_COLLECTION=karani_memories
# MEM0_USER_ID=kelyn

# --- LLM qualification (default provider: OpenRouter) ---
QUAL_PROVIDER=openrouter                        # openrouter | anthropic | local
QUAL_MODEL=moonshotai/kimi-k2-thinking          # any OpenRouter model slug
QUAL_REASONING_EFFORT=high                      # low | medium | high
QUAL_MAX_TOKENS=8000                            # generous to allow reasoning
QUAL_TIMEOUT_SECONDS=180                        # thinking models are slow
RESUME_PATH=data/resume.md

# OpenRouter (default provider)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_APP_NAME=karani
OPENROUTER_APP_URL=https://github.com/cod3smith/karani

# Anthropic (optional — install with `uv sync --extra anthropic`)
# ANTHROPIC_API_KEY=sk-ant-...

# Local LLM (optional — QUAL_PROVIDER=local; any OpenAI-compatible server:
# Ollama, LM Studio, vLLM, llama.cpp). Zero token cost; good for bulk
# qualification. Keep a stronger hosted model for drafting.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen3:32b
# LOCAL_LLM_TIMEOUT_SECONDS=600
# LOCAL_LLM_MAX_TOKENS=8000

# Optional overrides — see ingestion/config.py for defaults.
# MIN_COMP_USD=180000
# TARGET_COMP_USD=220000
# STALE_JOB_DAYS=10
# HTTP_CONCURRENCY=6
